#--------------------------------------------------------------------
# Example Environment Configuration file
#--------------------------------------------------------------------
# This file serves as a template for your .env file.
# Copy this to .env and fill in the details for your environment.
#
# NOTE: The defaults below are pre-configured to match the bundled
# docker-compose.yml (MySQL 8.4 + Dozzle + Apache) out of the box.
# For a local (non-Docker) install, update the database.default.* and
# app.baseURL values to match your machine.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# App Settings
# Docker: served on standard port 80 (http://localhost/). For local php spark serve use http://localhost:8080/
app.baseURL = 'http://localhost/'
app.forceGlobalSecureRequests = false

# Database Settings — match the mysql service in docker-compose.yml
database.default.hostname = mysql
database.default.database = db_my_coder
database.default.username = root
database.default.password = root_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Email (optional) — disabled by default for local/private deployments
AUTH_SEND_EMAIL_ON_REGISTER = false
email.fromEmail = "noreply@example.com"
email.fromName = "System Admin"

# Encryption Settings (Generate with: php spark key:generate)
# Used to encrypt API keys at rest (AES-256-CTR). A 32-byte hex key
# can be generated with: openssl rand -hex 32
encryption.key = hex2bin:
