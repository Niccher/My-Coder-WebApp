# CodeIgniter 4 Environment Configuration
CI_ENVIRONMENT = development

# App Settings
app.baseURL = 'http://192.168.100.80:9003/'

# Database Settings
database.default.hostname = 'mysql'
database.default.username = 'root'
database.default.password = 'root_password'
database.default.database = 'db_my_coder'
database.default.DBDriver = 'MySQLi'
database.default.port = 3306
database.default.socket = ''


#--------------------------------------------------------------------
# EMAIL CONFIGURATION
#--------------------------------------------------------------------
# This toggle controls whether to send an email on user registration.
AUTH_SEND_EMAIL_ON_REGISTER=false

email.fromEmail = "noreply@example.com"
email.fromName = "System Admin"
email.protocol = "smtp"
email.SMTPHost = "smtp.mailtrap.io"
email.SMTPUser = "dummy_user"
email.SMTPPass = "dummy_pass"
email.SMTPPort = 2525
email.SMTPCrypto = "tls"
app.forceGlobalSecureRequests = false


# Encryption Key
encryption.key = hex2bin:af9bd2c5812a89c3947fb526fe9cc8984c7013b74a6d19025f36e9199861f4eb
